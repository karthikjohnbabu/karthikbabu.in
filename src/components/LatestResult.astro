    </div>
    <div class="metric">
      <div class="metric-label">10 one by one · tok/s</div>
      <div class="metric-value mono">203 <span style="color:var(--ink-muted);font-size:0.85rem;">vs 181</span></div>
      <div class="metric-sub">vLLM (197–213) · Transformers (180–186)</div>
    </div>
    <div class="metric">
      <div class="metric-label">100 together · tok/s</div>
      <div class="metric-value mono">4,133</div>
      <div class="metric-sub">vLLM only (2,647–5,571). Transformers not run at this batch.</div>
